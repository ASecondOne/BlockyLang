<define>
    let counter, Number = 1;
    let unset;
    let inferred = "String".new();
    let text, String;
    let score, Number;
    let enabled, Bool;
    let initialized, String = "Typed initializer";
    
    mut counter;
    mut text;
    mut score;
    mut enabled;
</define>

<execute>
    println "Values and output";
    println unset;
    println text;
    println text.type();
    println score.type();
    println enabled.type();

    text = "Blocky Lang";
    score = 42;
    enabled = true;
    inferred.set_AcMods("mutabl");
    inferred = "Initialized with new";
    println initialized;

    print "print stays on this line; ";
    println text;
    println score;
    println enabled;

    println "Calls and inspection";
    println inc_one 4;
    println(inc_one(5));
    println 42.type();
    println text.origin();
    println text.get_AcMods();
    i_core::stdout::println "Full keyword paths work too";

    counter.set_AcMods("mutabl");
    counter = inc_one counter;
    println counter;

    if false, {
        println "This branch does not run";
    }

    println "Nested closures transfer one level at a time";
    if true, {
        println "This closure runs";
        counter = inc_one counter;
        if true, {
            counter = inc_one counter;
            transfer counter;
        }
        println "After inner transfer:";
        println counter;
        transfer counter;
    }

    println "After outer transfer:";
    println counter;

    {
        counter = 99;
        println counter;
    }

    println counter;
</execute>
