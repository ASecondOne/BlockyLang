    let num = 4.003;
    let string = "Hello";
    let foo7 = 4;
    let boolean = false;
    let undefined a;
</define>

<execute>
    foo7 = 1;
    
    println 
    foo7
    ;

    println boolean;

    println a;
</execute>

<execute>
    println foo7 + 1;
